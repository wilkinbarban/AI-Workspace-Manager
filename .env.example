# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║              AI WORKSPACE MANAGER — Variables de Entorno                   ║
# ║  Copia este archivo como .env y ajusta los valores según tu entorno.       ║
# ║  NUNCA subas tu .env real a Git — ya está en .gitignore.                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (requerido)
# ──────────────────────────────────────────────────────────────────────────────

# Ruta al archivo SQLite local usado por Prisma.
# La ruta es relativa al directorio de Prisma (prisma/schema.prisma).
# En desarrollo apunta a la carpeta .data/ en la raíz del proyecto.
DATABASE_URL="file:../../../.data/ai-workspace-manager.db"

# ──────────────────────────────────────────────────────────────────────────────
# PROVEEDORES DE IA SOPORTADOS
# ──────────────────────────────────────────────────────────────────────────────
# La forma recomendada es configurarlos desde la UI (Ajustes → Proveedores).
# Las claves se guardan en el almacén seguro del sistema (keychain/credential
# store) y NO en este archivo. Usa estas variables solo como fallback en
# entornos de CI/CD, scripts o cuando no tengas acceso a la interfaz gráfica.

# ─── 1. DeepSeek ───────────────────────────────────────────────────────────
# Proveedor recomendado por su excelente relación calidad/precio.
# Obtén tu clave en: https://platform.deepseek.com
# Modelos disponibles: deepseek-chat, deepseek-v4-flash, deepseek-reasoner
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# ─── 2. OpenAI ─────────────────────────────────────────────────────────────
# Obtén tu clave en: https://platform.openai.com/api-keys
# Modelos disponibles: gpt-4o, gpt-4o-mini, gpt-4-turbo, o1-mini, o1-preview
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"   # Cambia solo si usas un proxy
# OPENAI_MODEL="gpt-4o-mini"

# ─── 3. Anthropic (Claude) ─────────────────────────────────────────────────
# Obtén tu clave en: https://console.anthropic.com
# Modelos disponibles: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-3-5
ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# ─── 4. Google Gemini ──────────────────────────────────────────────────────
# Obtén tu clave en: https://aistudio.google.com/app/apikey
# Modelos disponibles: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_API_KEY=""
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# GEMINI_MODEL="gemini-2.0-flash"

# ─── 5. OpenRouter ─────────────────────────────────────────────────────────
# Unifica el acceso a múltiples LLMs con una sola clave.
# Permite usar GPT-4o, Claude, Gemini, Llama y más desde un único endpoint.
# Obtén tu clave en: https://openrouter.ai/keys
# Ejemplos de modelos: openai/gpt-4o, anthropic/claude-3-5-sonnet,
#                      google/gemini-flash-1.5, meta-llama/llama-3-70b
OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL="anthropic/claude-3-5-sonnet"
