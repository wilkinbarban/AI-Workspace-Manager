# AI Workspace Manager - Variables de entorno
#
# Copia este archivo como .env y ajusta los valores segun tu entorno.
# No subas tu .env real al repositorio.

# Base de datos local SQLite usada por Prisma.
# La ruta es relativa a src/database/prisma/schema.prisma.
DATABASE_URL="file:../../../.data/ai-workspace-manager.db"

# Proveedores de IA
#
# Recomendado: configura proveedores desde la UI, en Ajustes -> Proveedores.
# Las claves guardadas desde la aplicacion usan el almacen seguro del sistema
# cuando keytar esta disponible.
#
# Usa estas variables como fallback para desarrollo, CI o ejecuciones sin UI.

# DeepSeek
# Consola: https://platform.deepseek.com
# API: https://api.deepseek.com
# Modelos registrados: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# OpenAI
# Claves: https://platform.openai.com/api-keys
# Modelos registrados: gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, gpt-4o, o3, o4-mini
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4.1-mini"

# Anthropic Claude
# Claves: https://console.anthropic.com
# Modelos registrados: claude-sonnet-4-6, claude-opus-4-7, claude-haiku-4-5
ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Google Gemini
# Claves: https://aistudio.google.com/app/apikey
# Modelos registrados: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite
GEMINI_API_KEY=""
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# GEMINI_MODEL="gemini-2.5-flash"

# OpenRouter
# Claves: https://openrouter.ai/keys
# Modelo por defecto registrado: openai/gpt-4.1-mini
OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL="openai/gpt-4.1-mini"
